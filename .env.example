# Copia este archivo a .env y completa los valores. NUNCA commitees .env.
# Rama de DESARROLLO de Neon — la de producción solo vive en Vercel.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require"
# Conexión directa (sin -pooler) para `prisma migrate`.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Panel /admin del dueño
ADMIN_PASSWORD="cambia-esta-clave"
# 64+ caracteres aleatorios: firma la cookie de sesión (HMAC-SHA256)
ADMIN_SESSION_SECRET="cambia-este-secreto-largo-y-aleatorio"
# Opcional: duración de la sesión admin en horas (default 168 = 7 días)
# ADMIN_SESSION_TTL_HOURS=168
